{
  "/css/spc.css": {
    "get": {
      "x-mojo-to": "Static#get",
      "operationId": "spcStaticCss",
      "tags": ["pluginStatic"],
      "responses": {
        "200": {
          "description": "File found",
          "schema": { "type": "file" }
        },
        "404": {
          "description": "File not found",
          "schema": {
            "type": "object",
            "properties": { "error": { "type": "string" } }
          }
        }
      }
    }
  },
