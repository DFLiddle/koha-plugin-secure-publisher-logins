[% WRAPPER "wrapper-staff-tool-plugin.inc" method="tool" plugin_title=plugin_title %]

<h1>[% plugin_title | html %]</h1>

[% IF !health.ok %]
<div class="alert alert-danger">
  <strong>[% l.config_required | html %]</strong>
  <ul class="mb-0">[% FOREACH e IN health.errors %]<li>[% e | html %]</li>[% END %]</ul>
</div>
[% END %]

[% IF health.warnings.size %]
<div class="alert alert-warning">
  <ul class="mb-0">[% FOREACH w IN health.warnings %]<li>[% w | html %]</li>[% END %]</ul>
</div>
[% END %]

<p>
  <a class="btn btn-default" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool&amp;action=new">[% l.add_login | html %]</a>
  <a class="btn btn-default" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool&amp;view=log">[% l.view_log | html %]</a>
</p>

<table class="table table-striped">
  <thead>
    <tr>
      <th>[% l.publisher | html %]</th>
      <th>[% l.domains | html %]</th>
      <th>[% l.accessible | html %]</th>
      <th>[% l.actions | html %]</th>
    </tr>
  </thead>
  <tbody>
    [% FOREACH row IN login_rows %]
    <tr>
      <td>[% row.login.publisher_name | html %]</td>
      <td>[% row.login.domains | html %]</td>
      <td>[% row.scope_label | html %]</td>
      <td>
        <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool&amp;edit_id=[% row.login.id | html %]">[% l.edit | html %]</a>
        [% IF is_superlib || can_manage %]
        | <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool&amp;delete_id=[% row.login.id | html %]" onclick="return confirm('[% l.delete_confirm | html %]');">[% l.delete | html %]</a>
        [% END %]
      </td>
    </tr>
    [% END %]
  </tbody>
</table>

[% END %]
