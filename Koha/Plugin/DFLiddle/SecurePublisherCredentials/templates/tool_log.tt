[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Secure Publisher Logins access log</title>
[% INCLUDE 'doc-head-close.inc' %]
<body id="intranet-main" class="intranet-main">
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div class="breadcrumb">
  <a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo;
  <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool">Secure Publisher Logins</a> &rsaquo;
  Access log
</div>

<div class="container-fluid">
  <h1>Publisher login access log</h1>

  <table class="table table-striped table-condensed">
    <thead>
      <tr>
        <th>When</th>
        <th>Login ID</th>
        <th>Borrowernumber</th>
        <th>Action</th>
        <th>Biblionumber</th>
      </tr>
    </thead>
    <tbody>
      [% FOREACH row IN logs %]
      <tr>
        <td>[% row.logged_on | html %]</td>
        <td>[% row.credential_id | html %]</td>
        <td>[% row.borrowernumber | html %]</td>
        <td>[% row.action | html %]</td>
        <td>[% row.biblionumber | html %]</td>
      </tr>
      [% END %]
    </tbody>
  </table>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
