[% WRAPPER "wrapper-staff-tool-plugin.inc" method="tool" plugin_title=plugin_title %]

<h1>[% l.access_log | html %]</h1>

<p>
  <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool">[% l.back_to_list | html %]</a>
</p>

<table class="table table-striped table-condensed">
  <thead>
    <tr>
      <th>[% l.when | html %]</th>
      <th>[% l.login_id | html %]</th>
      <th>[% l.borrowernumber | html %]</th>
      <th>[% l.action | html %]</th>
      <th>[% l.biblionumber | html %]</th>
    </tr>
  </thead>
  <tbody>
    [% FOREACH row IN logs %]
    <tr>
      <td>[% row.logged_on | html %]</td>
      <td>[% row.credential_id | html %]</td>
      <td>[% row.borrowernumber | html %]</td>
      <td>[% row.action | html %]</td>
      <td>[% row.biblionumber | html %]</td>
    </tr>
    [% END %]
  </tbody>
</table>

[% END %]
