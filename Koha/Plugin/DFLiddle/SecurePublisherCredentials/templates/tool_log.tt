[% WRAPPER "wrapper-staff-tool-plugin.inc" method="tool" plugin_title=plugin_title %]

<h1>Publisher login access log</h1>

<p>
  <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool">Back to login list</a>
</p>

<table class="table table-striped table-condensed">
  <thead>
    <tr>
      <th>When</th>
      <th>Login ID</th>
      <th>Borrowernumber</th>
      <th>Action</th>
      <th>Biblionumber</th>
    </tr>
  </thead>
  <tbody>
    [% FOREACH row IN logs %]
    <tr>
      <td>[% row.logged_on | html %]</td>
      <td>[% row.credential_id | html %]</td>
      <td>[% row.borrowernumber | html %]</td>
      <td>[% row.action | html %]</td>
      <td>[% row.biblionumber | html %]</td>
    </tr>
    [% END %]
  </tbody>
</table>

[% END %]
